local validCommands = {
	[":cmds"] = true,
	[":speed"] = true,
	[":jump"] = true,
	[":fly"] = true,
	[":unfly"] = true,
	[":noclip"] = true,
	[":clip"] = true,
	[":god"] = true,
	[":ungod"] = true,
	[":sit"] = true,
	[":fling"] = true,
	[":unfling"] = true,
	[":antilag"] = true,
	[":antiafk"] = true,
	[":reset"] = true,
	[":rejoin"] = true,
}

box.FocusLost:Connect(function(enterPressed)
	if not enterPressed then return end

	local rawText = string.lower(string.gsub(box.Text, "^%s*(.-)%s*$", "%1"))
	if rawText == "" then return end

	local args = string.split(rawText, " ")
	local command = args[1]
	local value = tonumber(args[2])

	if not string.find(command, "^:") then
		command = ":" .. command
	end

	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if command == ":cmds" then
		openPanel()

	elseif command == ":speed" then
		if humanoid then
			humanoid.WalkSpeed = value and math.clamp(value, 1, 1000) or 16
		end

	elseif command == ":jump" then
		if humanoid then
			humanoid.UseJumpPower = true
			humanoid.JumpPower = value and math.clamp(value, 1, 1000) or 50
		end

	elseif command == ":fly" then
		local speed = value and math.clamp(value, 1, 500) or 50
		startFly(speed)

	elseif command == ":unfly" then
		stopFly()

	elseif command == ":noclip" then
		setNoclip(true)

	elseif command == ":clip" then
		setNoclip(false)

	elseif command == ":god" then
		setGodMode(true)

	elseif command == ":ungod" then
		setGodMode(false)

	elseif command == ":sit" then
		if humanoid then
			humanoid.Sit = true
		end

	elseif command == ":fling" then
		setFling(true)

	elseif command == ":unfling" then
		setFling(false)

	elseif command == ":antilag" then
		enableAntiLag()

	elseif command == ":antiafk" then
		enableAntiAfk()

	elseif command == ":reset" then
		stopFly()
		setNoclip(false)
		setGodMode(false)
		setFling(false)
		if humanoid then
			humanoid.Health = 0
		end

	elseif command == ":rejoin" then
		TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)

	elseif validCommands[command] then
		print("Command entered:", command)

	else
		showNoFound("No Found")
	end

	box.Text = ""
end)

